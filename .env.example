# Google Gemini Free API Key (Google AI Studio'dan bepul olinadi: https://aistudio.google.com/app/apikey)
# HEMIS testlari uchun kalit shart emas, erkin matn va kitoblardan AI orqali test tuzishda ishlatiladi.
GEMINI_API_KEY="AIzaSy..."

# Telegram Bot Token (@BotFather orqali yaratilgan bot tokeni)
# Veb-sayt va Telegram Mini App (TMA) foydalanuvchilarini xavfsiz autentifikatsiya qilish uchun.
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Bot foydalanuvchi nomi (@ siz yoziladi)
TELEGRAM_BOT_USERNAME="QuizGenUzBot"

# Server porti (Standart: 3000)
PORT=3000
