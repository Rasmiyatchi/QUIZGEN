# ===================================================
# QUIZGEN v3 — Muhit O'zgaruvchilari (Environment Variables)
# ===================================================

# Server Konfiguratsiyasi
PORT=3000
NODE_ENV=production
APP_URL="https://quizgen.uz"

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# AI orqali test yaratish uchun
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Telegram Bot Sozlamalari (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="quizgenrobot"

# Xavfsizlik va JWT Sessiya Kalitlari (Productionda mutlaqo o'zgartiring!)
JWT_SECRET="quizgen_jwt_secret_change_in_production_super_secure_32chars"
JWT_REFRESH_SECRET="quizgen_refresh_secret_change_in_production_super_secure_32chars"

# Administrator Telegram ID lari (vergul bilan ajratilgan)
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Sinov va Demo Rejimi (Productionda 'false' bo'lishi shart!)
ENABLE_DEMO_AUTH="false"

# ===================================================
# TO'LOV TIZIMLARI SOZLAMALARI (M3)
# ===================================================

# Click Merchant API
CLICK_SERVICE_ID="12345"
CLICK_MERCHANT_ID="67890"
CLICK_SECRET_KEY="click_secret_key_here"

# Payme Merchant API
PAYME_MERCHANT_ID="payme_merchant_id_here"
PAYME_SECRET_KEY="payme_secret_key_here"
PAYME_TEST_KEY="payme_test_key_here"

# Qo'lda To'lov (Karta orqali kassa cheki)
MANUAL_PAYMENT_CARD_NUMBER="8600 0000 0000 0000"
MANUAL_PAYMENT_CARD_HOLDER="QUIZGEN LLC"
