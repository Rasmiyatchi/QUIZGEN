# ===================================================
# QUIZGEN v3 — Muhit O'zgaruvchilari (Environment Variables)
# ===================================================

# Server Konfiguratsiyasi
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Google Gemini Free API Key (https://aistudio.google.com/app/apikey)
# HEMIS testlari uchun kalit talab qilinmaydi, faqat erkin matnlar uchun.
GEMINI_API_KEY="AIzaSy..."

# Telegram Bot Sozlamalari (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="quizgenrobot"

# Xavfsizlik va JWT Sessiya Kalitlari (Productionda o'zgartiring!)
JWT_SECRET="quizgen_jwt_secret_change_in_production_32chars"
JWT_REFRESH_SECRET="quizgen_refresh_secret_change_in_production_32chars"

# Administrator Telegram ID lari (vergul bilan ajratilgan)
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Sinov va Demo Rejimi (Productionda 'false' bo'lishi shart!)
ENABLE_DEMO_AUTH="true"

# PostgreSQL URL (M1 bosqichida ulanadi)
# DATABASE_URL="postgresql://quizgen:password@localhost:5432/quizgen"
